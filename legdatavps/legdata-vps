#!/bin/zsh
# legdata VPS connector.
#
# Lives outside the project repository on purpose: the repo carries procedure,
# never host detail. This file holds the host address only — no password. The
# bootstrap password, needed once to install the SSH key, is read from a file
# whose path is passed in LD_PW_FILE and is never stored here.
#
# Usage:
#   legdata-vps 'command'            run as the working user over key auth
#   legdata-vps --root 'command'     run as root over password auth (bootstrap
#                                    only; stops working once hardening lands)
#   legdata-vps --scp SRC DST        copy a file up as the working user
set -e

LD_HOST=77.90.2.83
LD_PORT=22
LD_USER=ldadmin
LD_KEY=/Users/stevenmacgregor/.ssh/legdata_ed25519
KH=/Users/stevenmacgregor/.ssh/known_hosts_legdata

COMMON=(-o StrictHostKeyChecking=accept-new -o UserKnownHostsFile="$KH" \
        -o ConnectTimeout=20 -p "$LD_PORT")

case "$1" in
  --root)
    shift
    [ -n "$LD_PW_FILE" ] && [ -f "$LD_PW_FILE" ] || {
      echo "set LD_PW_FILE to a file holding the bootstrap password" >&2; exit 1; }
    SSHPASS=$(cat "$LD_PW_FILE") sshpass -e ssh "${COMMON[@]}" \
      -o PreferredAuthentications=password -o PubkeyAuthentication=no \
      "root@$LD_HOST" "$@"
    ;;
  --scp)
    shift
    scp -o StrictHostKeyChecking=accept-new -o UserKnownHostsFile="$KH" \
      -P "$LD_PORT" -i "$LD_KEY" "$1" "$LD_USER@$LD_HOST:$2"
    ;;
  *)
    ssh "${COMMON[@]}" -i "$LD_KEY" -o IdentitiesOnly=yes \
      "$LD_USER@$LD_HOST" "$@"
    ;;
esac
